<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_login_card"
    android:padding="16dp">

    <ImageView
        android:id="@+id/img_trend"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_trend_neutral"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Manzana"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/txt_product_price"
        app:layout_constraintStart_toEndOf="@id/img_trend"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_store_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mercado Local"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/txt_product_name"
        app:layout_constraintStart_toStartOf="@id/txt_product_name"
        app:layout_constraintTop_toBottomOf="@id/txt_product_name" />

    <LinearLayout
        android:id="@+id/variation_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/txt_product_name"
        app:layout_constraintTop_toBottomOf="@id/txt_store_name">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Precio anterior"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_previous_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$32.00 MXN"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Variación"
                android:textColor="#80FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txt_variation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-4.00 (-12.5%)"
                android:textColor="#FF5252"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_product_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="$45.00"
        android:textColor="@color/text_gold"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/txt_store_name"
        app:layout_constraintEnd_toStartOf="@+id/btn_favorite"
        app:layout_constraintTop_toTopOf="@+id/txt_product_name" />

    <ImageView
        android:id="@+id/btn_expand"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_trend_down"
        app:layout_constraintBottom_toBottomOf="@id/btn_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_more"
        app:tint="#80FFFFFF" />

    <ImageView
        android:id="@+id/btn_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="@+id/txt_product_price"
        app:layout_constraintEnd_toStartOf="@+id/btn_expand"
        app:layout_constraintTop_toTopOf="@+id/txt_product_price" />

    <ImageView
        android:id="@+id/btn_favorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_star_outline"
        app:layout_constraintBottom_toBottomOf="@+id/txt_product_price"
        app:layout_constraintEnd_toStartOf="@+id/btn_more"
        app:layout_constraintTop_toTopOf="@+id/txt_product_price" />

</androidx.constraintlayout.widget.ConstraintLayout>