<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="1024dp"
    android:height="1536dp"
    android:viewportWidth="1024"
    android:viewportHeight="1536">

    <!-- Background Navy Gradient (Solid) -->
    <path android:pathData="M0,0h1024v1536h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="1024"
                android:endY="1536"
                android:type="linear">
                <item android:offset="0" android:color="@color/navy_start" />
                <item android:offset="1" android:color="@color/navy_end" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper wings (Gold Lines) -->
    <path
        android:pathData="M0,0 L290,290 L135,290 L0,155 M0,75 L235,310 L75,310 L0,235 M0,160 L170,330 L45,330 L0,285"
        android:strokeWidth="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="290"
                android:endY="330"
                android:type="linear">
                <item android:offset="0" android:color="@color/gold_start" />
                <item android:offset="0.5" android:color="@color/gold_mid" />
                <item android:offset="1" android:color="@color/gold_end" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M1024,0 L734,290 L889,290 L1024,155 M1024,75 L789,310 L949,310 L1024,235 M1024,160 L854,330 L979,330 L1024,285"
        android:strokeWidth="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="1024"
                android:startY="0"
                android:endX="734"
                android:endY="330"
                android:type="linear">
                <item android:offset="0" android:color="@color/gold_start" />
                <item android:offset="0.5" android:color="@color/gold_mid" />
                <item android:offset="1" android:color="@color/gold_end" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central emblem (The Diamond/Crystal) -->
    <group
        android:translateX="512"
        android:translateY="400">

        <!-- Circle Background Glow -->
        <path
            android:pathData="M0,0m-140,0a140,140 0,1 1,280,0a140,140 0,1 1,-280,0"
            android:strokeWidth="2">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="-140"
                    android:startY="-140"
                    android:endX="140"
                    android:endY="140"
                    android:type="linear">
                    <item android:offset="0" android:color="#20FFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Crystal Top (Blue) -->
        <path
            android:pathData="M0,-100 L70,0 L0,10 L-70,0 Z"
            android:strokeColor="#BFE0FF"
            android:strokeWidth="2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="-100"
                    android:endX="0"
                    android:endY="10"
                    android:type="linear">
                    <item android:offset="0" android:color="#4F8FD0" />
                    <item android:offset="1" android:color="#0D1B3E" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Crystal Bottom (Gold) -->
        <path
            android:pathData="M-70,0 L0,10 L70,0 L0,80 Z"
            android:strokeColor="#F7D66F"
            android:strokeWidth="2">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="0"
                    android:startY="0"
                    android:endX="0"
                    android:endY="80"
                    android:type="linear">
                    <item android:offset="0" android:color="@color/gold_start" />
                    <item android:offset="1" android:color="@color/gold_end" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Center Line -->
        <path
            android:pathData="M0,-100 L0,80"
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="1"/>
    </group>

    <!-- Lower accents (Subtle Blue lines at bottom) -->
    <path
        android:pathData="M0,1300 L250,1536 M1024,1300 L774,1536"
        android:strokeColor="#1A4F8FD0"
        android:strokeWidth="3"/>

</vector>